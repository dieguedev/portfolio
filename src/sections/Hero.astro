---
import HeroBackground from "../components/ui/HeroBackground";
import Loader from "../components/Loader.astro";
import diegue from "../assets/diegue.svg";
import logo from "../assets/logo.svg";
---

<section
  id="home"
  class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden bg-black"
  aria-labelledby="home-title"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <HeroBackground client:idle />
  </div>

  <div class="absolute inset-0 z-[1] bg-black/70"></div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-[920px] flex-col items-center px-6 text-center text-white"
  >
    <h1 id="home-title" class="sr-only">
      Diegue, desarrollador web en Pamplona
    </h1>
    <p
      class="eyebrow mb-3 text-white/60 sm:text-sm"
      aria-hidden="true"
    >
      DESARROLLADOR FRONTEND
    </p>
    <div
      class="text-[clamp(3.5rem,15vw,8.5rem)] font-semibold leading-[0.85] tracking-normal text-white drop-shadow-[0_12px_32px_rgba(0,0,0,0.45)] mb-2 sm:mb-6"
      aria-hidden="true"
    >
      <span>hola, soy</span>
      <span class="text-accent">
        diegue
      </span>
    </div>
    <p
      class="mt-5 max-w-[32rem] text-sm font-normal leading-6 text-white/80 sm:text-base sm:leading-7"
    >
      Construyo experiencias web rápidas y accesibles utilizando React,
      TypeScript y una gran atención al detalle.
    </p>
  </div>

  <div class="absolute bottom-20 z-10" aria-hidden="true">
    <Loader
      spinningIcon={diegue.src}
      centerIcon={logo.src}
      rotationDuration={10}
      size={80}
    />
  </div>
</section>
