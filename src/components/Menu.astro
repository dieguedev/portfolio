---
import {
  At,
  BriefcaseAlt2,
  HomeAlt2,
  InfoCircle,
  Menu as MenuIcon,
} from "@boxicons/react";
import logo from "../assets/logo.svg";

const pathname = Astro.url.pathname;

const menuItems = [
  { href: "/", label: "Inicio", Icon: HomeAlt2 },
  { href: "/about", label: "Acerca de", Icon: InfoCircle },
  { href: "/work", label: "Trabajo", Icon: BriefcaseAlt2 },
  { href: "/contact", label: "Contacto", Icon: At },
] as const;

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<nav
  class="glassmorphism fixed left-1/2 top-8 z-[60] inline-flex w-[85dvw] -translate-x-1/2 items-center justify-between rounded-2xl bg-white/[0.08] px-4 py-2 text-white/65 md:w-[75dvw]"
  aria-label="Navegación principal"
>
  <a
    href="/"
    aria-label="Ir a inicio"
    class="rounded-xl p-1 transition-colors hover:bg-white/[0.08] focus-visible:outline focus-visible:outline-2 focus-visible:outline-white/50"
  >
    <img
      src={logo.src}
      width="48"
      height="48"
      alt=""
      aria-hidden="true"
      class="brightness-0 invert"
    />
  </a>

  <button
    id="mobile-menu-toggle"
    class="flex items-center gap-2 rounded-xl px-3 py-2 text-white/80 transition-colors hover:bg-white/[0.12] hover:text-white sm:hidden"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu-overlay"
  >
    <span data-label-open class="flex items-center gap-2">
      <span class="text-sm font-medium">Menu</span>
      <MenuIcon width={22} height={22} fill="currentColor" aria-hidden="true" />
    </span>
    <span data-label-close class="hidden items-center gap-2">
      <span class="text-sm font-medium">Cerrar</span>
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        ></path>
      </svg>
    </span>
  </button>

  <ul class="hidden gap-2 sm:flex">
    {
      menuItems.map(({ href, label, Icon }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="flex min-w-16 flex-col items-center justify-center gap-1 rounded-xl border border-transparent px-3 py-2 text-xs font-medium text-white/75 transition-colors duration-200 hover:bg-white/[0.08] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white/50 aria-[current=page]:bg-white/[0.08] aria-[current=page]:text-white aria-[current=page]:shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]"
          >
            <Icon
              width={22}
              height={22}
              fill="currentColor"
              aria-hidden="true"
            />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<!-- Mobile overlay menu -->
<div
  id="mobile-menu-overlay"
  role="region"
  aria-label="Menú de navegación móvil"
  aria-expanded="false"
  aria-hidden="true"
  class="fixed inset-0 z-[55] flex flex-col bg-black sm:hidden"
>
  <div class="h-28 shrink-0"></div>
  <nav
    class="flex flex-1 flex-col justify-center px-8 pb-16"
    aria-label="Menú móvil"
  >
    <ul class="flex flex-col">
      {
        menuItems.map(({ href, label }, index) => (
          <li class="mobile-nav-item">
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class="group flex items-baseline gap-5 py-6 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/30"
            >
              <span class="w-6 font-mono text-xs leading-none text-white/30 tabular-nums">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="text-[2.5rem] font-semibold leading-none text-white/70 transition-colors duration-200 group-hover:text-white aria-[current=page]:text-white">
                {label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  #mobile-menu-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  #mobile-menu-overlay[aria-expanded="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  #mobile-menu-overlay[aria-expanded="true"] .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-menu-overlay[aria-expanded="true"] .mobile-nav-item:nth-child(1) {
    transition-delay: 0.08s;
  }
  #mobile-menu-overlay[aria-expanded="true"] .mobile-nav-item:nth-child(2) {
    transition-delay: 0.14s;
  }
  #mobile-menu-overlay[aria-expanded="true"] .mobile-nav-item:nth-child(3) {
    transition-delay: 0.20s;
  }
  #mobile-menu-overlay[aria-expanded="true"] .mobile-nav-item:nth-child(4) {
    transition-delay: 0.26s;
  }
</style>

<script>
  let menuController: AbortController | null = null;

  function initMenu() {
    menuController?.abort();
    menuController = new AbortController();
    const { signal } = menuController;

    const toggle = document.getElementById(
      "mobile-menu-toggle",
    ) as HTMLButtonElement | null;
    const overlay = document.getElementById(
      "mobile-menu-overlay",
    ) as HTMLElement | null;

    if (!toggle || !overlay) return;

    const labelOpen = toggle.querySelector<HTMLElement>("[data-label-open]");
    const labelClose = toggle.querySelector<HTMLElement>("[data-label-close]");
    let isOpen = false;

    const openMenu = (): void => {
      isOpen = true;
      overlay.setAttribute("aria-expanded", "true");
      overlay.removeAttribute("aria-hidden");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      labelOpen?.classList.add("hidden");
      labelClose?.classList.remove("hidden");
      labelClose?.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = (): void => {
      isOpen = false;
      overlay.setAttribute("aria-expanded", "false");
      overlay.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      labelOpen?.classList.remove("hidden");
      labelClose?.classList.add("hidden");
      labelClose?.classList.remove("flex");
      document.body.style.overflow = "";
    };

    toggle.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()), { signal });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closeMenu();
    }, { signal });
  }

  document.addEventListener("astro:page-load", initMenu);
</script>
