---
import Layout from "../layouts/Layout.astro";
import TechMarquee from "../components/TechMarquee.astro";
import starUrl from "../assets/star.svg?url";

const experiencia = [
  { role: "Front-end Developer", company: "JAKALA Iberia", period: "Ene. 24 — hoy." },
  { role: "Front-end Developer", company: "Biko",          period: "Jul. 23 — Ene. 24." },
  { role: "Developer Trainee",   company: "Biko",          period: "Mar. 23 — Jul. 23." },
];
import {
  TypescriptIcon,
  _React,
  NextjsIcon,
  TailwindIcon,
  SupabaseIcon,
  ReactQueryIcon,
  Jest,
  CypressIcon,
  TestingLibrary,
  AstroIcon,
} from "@dev.icons/react/mono";
import { Linkedin } from "@boxicons/react";

const tecnologias = [
  { name: "TypeScript", icon: TypescriptIcon },
  { name: "React", icon: _React },
  { name: "Next.js", icon: NextjsIcon },
  { name: "Tailwind", icon: TailwindIcon },
  { name: "Supabase", icon: SupabaseIcon },
  { name: "TanStack Query", icon: ReactQueryIcon },
  { name: "Jest", icon: Jest },
  { name: "Cypress", icon: CypressIcon },
  { name: "Testing Library", icon: TestingLibrary },
  { name: "Astro", icon: AstroIcon },
];
---

<Layout title="Diegue | Acerca de">
  <main class="min-h-dvh bg-black text-white">
    <section
      class="mx-auto max-w-[920px] px-6 pb-16 pt-40"
      aria-labelledby="about-title"
    >
      <div class="mb-8 md:mb-12">
        <h1
          class="mb-5 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
          aria-hidden="true"
        >
          Acerca de
        </h1>
        <p
          id="about-title"
          class="text-[clamp(3rem,12vw,7rem)] font-semibold leading-[0.88] tracking-normal text-white"
        >
          <span class="font-display text-[1.12em] font-semibold italic">
            diegue
          </span>
        </p>
      </div>

      <blockquote class="mb-16 border-l-[3px] border-l-white/40 pl-6">
        <p
          class="text-base leading-7 text-white/80 sm:text-[1.05rem] sm:leading-8"
        >
          Desarrollador web en <strong class="font-semibold text-white"
            >Pamplona</strong
          >
          especializado en React y TypeScript. Creo experiencias web rápidas, accesibles
          y bien diseñadas para <strong class="font-semibold text-white"
            >empresas, startups y profesionales</strong
          >
          que buscan una <strong class="font-semibold text-white"
            >presencia digital sólida.</strong
          >
        </p>
      </blockquote>

      <div id="tech-section">
        <TechMarquee tecnologias={tecnologias} />
      </div>
    </section>

    <section class="mx-auto max-w-[920px] px-6 pt-4 pb-20" aria-label="Experiencia">
      <div class="relative">
        <div class="absolute left-5 md:left-1/2 md:-translate-x-1/2 top-0 bottom-0 w-[2px] bg-white/[0.15]" />

        {experiencia.map((job, i) => {
          const isLeft = i % 2 === 0;
          return (
            <div class="py-10 md:py-14">

              {/* Mobile */}
              <div class="grid grid-cols-[40px_1fr] items-center gap-x-5 md:hidden">
                <div class="flex justify-center relative z-10">
                  <img src={starUrl} class="w-9 h-auto" alt="" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs text-white/40 mb-1 tabular-nums">{job.period}</p>
                  <p class="text-base font-bold text-white leading-tight">{job.role}</p>
                  <p class="text-sm text-white/55 mt-0.5">{job.company}</p>
                </div>
              </div>

              {/* Desktop */}
              <div class="hidden md:grid md:grid-cols-[1fr_80px_1fr] items-center">
                <div class={isLeft ? "text-right pr-10" : ""}>
                  {isLeft && (
                    <>
                      <p class="text-xs text-white/40 mb-2 tabular-nums">{job.period}</p>
                      <p class="text-lg font-bold text-white leading-tight">{job.role}</p>
                      <p class="text-sm text-white/55 mt-1">{job.company}</p>
                    </>
                  )}
                </div>
                <div class="relative z-10">
                  <img src={starUrl} class="w-12 h-auto block mx-auto translate-x-[4px]" alt="" aria-hidden="true" />
                </div>
                <div class={!isLeft ? "pl-10" : ""}>
                  {!isLeft && (
                    <>
                      <p class="text-xs text-white/40 mb-2 tabular-nums">{job.period}</p>
                      <p class="text-lg font-bold text-white leading-tight">{job.role}</p>
                      <p class="text-sm text-white/55 mt-1">{job.company}</p>
                    </>
                  )}
                </div>
              </div>

            </div>
          );
        })}
      </div>
    </section>

    <div
      class="border-t border-white/[0.08] px-6 py-24 text-center"
      style="background: radial-gradient(ellipse 100% 80% at 50% 0%, rgba(255,255,255,0.13) 0%, transparent 100%)"
    >
      <div class="mx-auto max-w-[920px]">
        <p
          class="text-xs font-medium uppercase tracking-[0.14em] md:tracking-[0.28em] text-white/40 mb-2 md:mb-0"
        >
          No lo pienses más
        </p>
        <h2
          class="mb-5 text-[clamp(2.5rem,8vw,5rem)] font-semibold font-display leading-[0.92] text-white"
        >
          ¿Listo para empezar?
        </h2>
        <p class="mx-auto mb-10 max-w-sm text-base leading-7 text-white/55">
          Hagamos que tu web deje de parecer una plantilla.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-black transition-opacity duration-200 hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white/50"
          >
            Contactar
          </a>
          <a
            href="https://linkedin.com/in/diego-bogo/"
            class="glassmorphism inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white/70 transition-colors duration-200 hover:bg-white/[0.12] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white/50"
          >
            <Linkedin size="sm" />
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
