---
import Layout from "../layouts/Layout.astro";
import { At } from "@boxicons/react";

const techs = [
  "React",
  "TypeScript",
  "Next.js",
  "Astro",
  "Tailwind CSS",
  "Vite",
  "Node.js",
  "Git",
];

const values = [
  "Rendimiento y Core Web Vitals",
  "Accesibilidad web (WCAG)",
  "Código limpio y mantenible",
  "Atención al detalle visual",
];
---

<Layout title="Diegue | Acerca de">
  <main class="min-h-dvh bg-black text-white">
    <section
      class="mx-auto max-w-[920px] px-6 pb-28 pt-40"
      aria-labelledby="about-title"
    >
      <!-- Header -->
      <div class="mb-16">
        <h1
          class="mb-5 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
          aria-hidden="true"
        >
          Acerca de
        </h1>
        <p
          id="about-title"
          class="text-[clamp(3rem,12vw,7rem)] font-semibold leading-[0.88] tracking-normal text-white"
        >
          <span class="font-display text-[1.12em] font-semibold italic">
            diegue
          </span>
        </p>
      </div>

      <!-- Bio -->
      <blockquote class="mb-16 border-l-[3px] border-l-white/40 pl-6">
        <p
          class="text-base leading-7 text-white/80 sm:text-[1.05rem] sm:leading-8"
        >
          Desarrollador web en <strong class="font-semibold text-white"
            >Pamplona</strong
          >
          especializado en React y TypeScript. Creo experiencias web rápidas, accesibles
          y bien diseñadas para <strong class="font-semibold text-white"
            >empresas, startups y profesionales</strong
          >
          que buscan una <strong class="font-semibold text-white"
            >presencia digital sólida.</strong
          >
        </p>
      </blockquote>

      <!-- Tech marquee: scroll-jacked con GSAP -->
      <div id="tech-section" class="mb-16">
        <p
          class="mb-8 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
        >
          Tecnologías
        </p>
        <div class="overflow-hidden -mx-6 sm:mx-0">
          <ul
            id="marquee-track"
            class="flex will-change-transform"
            aria-label="Listado de tecnologías"
          >
            {
              [...techs, ...techs].map((name, i) => (
                <li
                  class="flex shrink-0 flex-col items-center gap-3"
                  aria-hidden={i >= techs.length ? "true" : undefined}
                >
                  <At
                    width={38}
                    height={38}
                    fill="currentColor"
                    aria-hidden="true"
                  />
                  <span class="text-xs font-medium uppercase tracking-[0.28em] text-white/50">
                    {name}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Enfoque -->
      <div class="glassmorphism mb-6 rounded-2xl p-8">
        <h2
          class="mb-6 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
        >
          Enfoque
        </h2>
        <ul class="space-y-4" aria-label="Listado de valores">
          {
            values.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-6 text-white/75">
                <span
                  class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-white/40"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Currently -->
      <div class="glassmorphism mb-6 rounded-2xl p-8">
        <h2
          class="mb-6 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
        >
          Actualmente
        </h2>
        <div class="grid gap-6 sm:grid-cols-3">
          <div>
            <p
              class="mb-1 text-[0.7rem] uppercase tracking-widest text-white/40"
            >
              Trabajando en
            </p>
            <p class="text-sm font-medium text-white/80">
              Proyectos freelance y personales
            </p>
          </div>
          <div>
            <p
              class="mb-1 text-[0.7rem] uppercase tracking-widest text-white/40"
            >
              Aprendiendo
            </p>
            <p class="text-sm font-medium text-white/80">
              Animaciones avanzadas con Motion
            </p>
          </div>
          <div>
            <p
              class="mb-1 text-[0.7rem] uppercase tracking-widest text-white/40"
            >
              Interesado en
            </p>
            <p class="text-sm font-medium text-white/80">
              Diseño de sistemas y UX
            </p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="glassmorphism rounded-2xl p-8">
        <h2
          class="mb-3 text-xs font-medium uppercase tracking-[0.28em] text-white/50"
        >
          ¿Hablamos?
        </h2>
        <p class="mb-6 max-w-md text-base leading-7 text-white/80">
          Si tienes un proyecto interesante o simplemente quieres charlar sobre
          web, no dudes en escribirme.
        </p>
        <a
          href="/contact"
          class="glassmorphism inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-medium text-white/75 transition-colors duration-200 hover:bg-white/[0.12] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white/50"
        >
          Contactar
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import gsap from "gsap";

  let cleanup: (() => void) | null = null;

  function initMarquee() {
    cleanup?.();

    const section = document.getElementById("tech-section");
    const track = document.getElementById("marquee-track");
    const container = track?.parentElement as HTMLElement | null;
    if (!section || !track || !container) return;

    const N = window.innerWidth < 640 ? 3 : 6;
    const itemWidth = container.offsetWidth / N;
    track.querySelectorAll<HTMLElement>("li").forEach((li) => {
      li.style.width = `${itemWidth}px`;
    });

    const translateEnd = track.scrollWidth / 2;
    let acc = 0;

    gsap.set(track, { x: 0 });

    // GSAP anima suavemente hacia el target acumulado
    const moveTo = gsap.quickTo(track, "x", {
      duration: 0.5,
      ease: "power2.out",
    });

    function onWheel(e: WheelEvent) {
      if (window.scrollY > 0) return;

      let dy = e.deltaY;
      if (e.deltaMode === 1) dy *= 40;
      if (e.deltaMode === 2) dy *= window.innerHeight;

      if (dy > 0 && acc >= translateEnd) return;
      if (dy < 0 && acc <= 0) return;

      e.preventDefault();
      acc = Math.min(translateEnd, Math.max(0, acc + dy));
      moveTo(-acc);
    }

    window.addEventListener("wheel", onWheel, { passive: false });

    cleanup = () => {
      window.removeEventListener("wheel", onWheel);
      gsap.killTweensOf(track);
    };
  }

  document.addEventListener("astro:page-load", initMarquee);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
